{
  "name": "khaugalli-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-role Food Ordering & Delivery Platform (Tiffin/KhauGalli)",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tiffin/db db:generate",
    "db:migrate": "pnpm --filter @tiffin/db db:migrate",
    "db:seed": "pnpm --filter @tiffin/db db:seed"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "fast-check": "^4.10.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
