# Environment Configuration for Tiffin (KhauGalli)

# Node environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL with PostGIS)
# For local Docker: postgresql://postgres:password@localhost:5432/tiffin_db
# For Neon / Supabase: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/tiffin_db
DIRECT_DATABASE_URL=postgresql://postgres:password@localhost:5432/tiffin_db

# Cache & Queues (Redis)
# For local Docker: redis://localhost:6379
# For Upstash: rediss://default:[password]@[host]:6379
REDIS_URL=redis://localhost:6379

# Auth & Secrets
JWT_SECRET=dev_jwt_secret_change_in_production_super_safe_key_123456
JWT_EXPIRES_IN=1d

# Razorpay (Sandbox / Test Mode)
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# Notifications
# Mode can be "mock" (in-memory/console logging for testing without real business accounts) or "live"
NOTIFICATION_MODE=mock
WHATSAPP_API_TOKEN=mock_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=mock_phone_id
RESEND_API_KEY=mock_resend_api_key

# Realtime
REALTIME_TRANSPORT=websocket # websocket | sse

# Client App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/realtime
